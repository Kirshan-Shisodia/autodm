    {
      "parameters": {
        "jsCode": "// Read the rate limit count from the HTTP node\nconst rows = $input.first().json;\n\n// Count DMs sent this hour (handle empty/object responses)\nlet sentThisHour = 0;\nif (Array.isArray(rows)) {\n  sentThisHour = rows.length;\n}\n\nconst LIMIT = 180; // stay under Meta's 200/hour cap\n\n// Pull full data from the Keyword Match Check node (exact name)\nconst data = $('Keyword Match Check').first().json;\n\nif (sentThisHour >= LIMIT) {\n  return [{\n    json: {\n      ...data,\n      action: 'QUEUE'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...data,\n    action: 'SEND'\n  }\n}];"
      },
