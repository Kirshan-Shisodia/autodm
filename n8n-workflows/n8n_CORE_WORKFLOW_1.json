    {
      "parameters": {
        "jsCode": "// automation comes directly as $json (n8n unpacks arrays automatically)\nconst automation   = $input.first().json;\nconst commentText  = $('Extract Comment Data').first().json.comment_text;\nconst keywords     = automation.trigger_keywords || [];\n\n// No keywords = trigger on any comment\nif (keywords.length === 0) {\n  return [{\n    json: {\n      ...automation,\n      ...$('Extract Comment Data').first().json\n    }\n  }];\n}\n\n// Check if comment contains any keyword\nconst matched = keywords.some(k =>\n  commentText.includes(k.toLowerCase().trim())\n);\n\nif (!matched) return [];\n\nreturn [{\n  json: {\n    ...automation,\n    ...$('Extract Comment Data').first().json\n  }\n}];"
      },
