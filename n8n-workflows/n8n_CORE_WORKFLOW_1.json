    {
      "parameters": {
        "jsCode": "const query = $request.query;\n\nconst mode      = query[\"hub.mode\"];\nconst token     = query[\"hub.verify_token\"];\nconst challenge = query[\"hub.challenge\"];\n\nconst myToken = $env.FB_WEBHOOK_VERIFY_TOKEN;\n\nif (mode === \"subscribe\" && token === myToken) {\n  return [{ json: { challenge: challenge } }];\n}\n\nthrow new Error(\"Forbidden - verify token does not match\");"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        0
      ],
      "id": "2e2d9491-f451-4235-968d-3fdd1f364f36",
      "name": "Code in JavaScript"
    },
