      "id": "506d60c7-7bb9-4b67-8e4c-86a4be74defd",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "const body  = $input.first().json.body;\nconst entry  = body.entry?.[0];\nconst change = entry?.changes?.[0];\nconst value  = change?.value;\n\n// Ignore comments from the page owner (don't DM yourself)\nif (value?.from?.id === entry?.id) {\n  return [];\n}\n\n// Only process comment events\nif (change?.field !== 'comments') {\n  return [];\n}\n\nreturn [{\n  json: {\n    comment_id:          value.id,\n    comment_text:        (value.text || '').toLowerCase().trim(),\n    commenter_id:        value.from?.id,\n    commenter_username:  value.from?.username,\n    post_id:             value.media?.id,\n    page_id:             entry.id,\n    received_at:         new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        288
      ],
      "id": "a64c2eca-af46-4bc2-bb14-6eb055da7473",
      "name": "Extract Comment Data"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst rawBody   = $input.first().json.rawBody;\nconst sigHeader = $input.first().json.headers['x-hub-signature-256'];\n\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', $env.FB_APP_SECRET)\n  .update(rawBody)\n  .digest('hex');\n\nif (sigHeader !== expected) {\n throw new Error('Invalid HMAC signature - request rejected');\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
